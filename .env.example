# SUPABASE_URL: Your Supabase project URL (e.g. https://xxxx.supabase.co)
# Configure this in the Secrets panel in AI Studio (or GitHub Actions Secrets for CI builds).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SUPABASE_ANON_KEY: Your Supabase project public anon/publishable key.
# Configure this in the Secrets panel in AI Studio (or GitHub Actions Secrets for CI builds).
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
